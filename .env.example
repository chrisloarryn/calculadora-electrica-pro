# Variables publicas incorporadas al bundle de la PWA.
# Nunca agregar secretos, tokens o credenciales con prefijo VITE_.
VITE_APP_VERSION=dev
VITE_ENGINE_VERSION=0.1.0
VITE_STANDARD_PROFILE_ID=CL-SEC-RIC

# Defaults no sensibles para scripts locales de despliegue.
GCP_PROJECT_ID=gcp-course-2024
GCP_REGION=southamerica-west1
CLOUD_RUN_STAGING_SERVICE=calculadora-electrica-staging
CLOUD_RUN_SERVICE=calculadora-electrica-pro
ARTIFACT_REGISTRY_REPOSITORY=calculadora-electrica
IMAGE_NAME=web
CLOUD_RUN_MEMORY=512Mi
CLOUD_RUN_CPU=1
CLOUD_RUN_TIMEOUT=300s
CLOUD_RUN_MIN_INSTANCES=0
CLOUD_RUN_STAGING_MAX_INSTANCES=1
CLOUD_RUN_MAX_INSTANCES=3

# GCP_SA_KEY se configura solo como GitHub Actions Secret.
# PORT es inyectada por Cloud Run en runtime.
